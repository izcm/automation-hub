{
  "name": "eu-kontroll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "start:postgres": "docker compose up -d && sleep 10 && npm run db:push && npm run seed:pg:employees && npm run seed:pg:vehicles && npm run seed:pg:eu-inspections",
    "db:push": "set -a && . ./.env.local && set +a && npx drizzle-kit push",
    "seed:pg:vehicles": "tsx --env-file=.env.local seed-db-scripts/postgres/seed.vehicles.ts",
    "seed:pg:employees": "tsx --env-file=.env.local seed-db-scripts/postgres/seed.employees.ts",
    "seed:pg:eu-inspections": "tsx --env-file=.env.local seed-db-scripts/postgres/seed.eu-inspections.ts",
    "test": "vitest run",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "@a2zb/lib": "file:../../izblocks/shared-packages/lib",
    "@a2zb/node": "file:../../izblocks/shared-packages/node",
    "@a2zb/react": "file:../../izblocks/shared-packages/react",
    "@a2zb/styles": "file:../../izblocks/shared-packages/styles",
    "@a2zb/types": "file:../../izblocks/shared-packages/types",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "qs": "^6.15.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/qs": "^6.15.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
